# mppx HMAC challenge-binding secret (required for mppx-managed / mppx-hmac)
MPPX_SECRET_KEY=

# Settlement signer private key for Permit2 / EIP-3009 paths.
# DO NOT commit real values — populate locally only.
SETTLEMENT_PRIVATE_KEY=

# Override curated default RPC URLs (optional; viem public providers fall
# back if unset).
RPC_URL_ETHEREUM=
RPC_URL_BSC=
RPC_URL_BSC_TESTNET=
RPC_URL_OPBNB=
RPC_URL_OPBNB_TESTNET=

# Live test wiring (env-gated; see test/live/*.live.test.ts)
BSC_TESTNET_AGENT_PK=
BSC_TESTNET_RECIPIENT=
OPBNB_TESTNET_AGENT_PK=
OPBNB_TESTNET_RECIPIENT=

# vite test mode: 'unit' | 'testnet' | 'mainnet-read'
VITE_NODE_ENV=testnet
