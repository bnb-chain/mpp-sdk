# Required — the payer's private key (32-byte hex; 0x prefix optional).
# This account pays: fund it on BSC Testnet with
#   - tBNB (gas)      → https://testnet.bnbchain.org/faucet-smart
#   - test USDT       → PancakeSwap BSC Testnet USDT
#     https://testnet.bscscan.com/token/0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
# NEVER use a mainnet key here. Generate a throwaway: openssl rand -hex 32
PAYER_PRIVATE_KEY=

# Optional — RPC override for the challenge's chain (defaults to the
# viem bundled public endpoint, which rate-limits).
# RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
