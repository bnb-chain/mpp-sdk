# Required — the payer's private key (32-byte hex; 0x prefix optional).
# This account pays: fund it on BSC Testnet with
#   - tBNB (gas)      → https://testnet.bnbchain.org/faucet-smart
#   - test USDT       → PancakeSwap BSC Testnet USDT
#     https://testnet.bscscan.com/token/0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
# NEVER use a mainnet key here. Generate a throwaway: openssl rand -hex 32
PAYER_PRIVATE_KEY=

# Optional — RPC override for the challenge's chain (defaults to the
# viem bundled public endpoint, which rate-limits).
# RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# ── `start:pay` only (the high-level pay() demo, src/pay-policy.ts) ──────────
# Optional — the chain your wallet is on. Defaults to 97 (BSC Testnet). pay()
# refuses if it does not equal the challenge's chain (pass allowChainMismatch to
# override, not exposed by this demo).
# CHAIN_ID=97

# Optional — the routing intent (how pay() ranks the offered routes):
#   auto | prefer-gasless (default) | require-gasless | prefer-direct | manual
# PAY_MODE=prefer-gasless

# b402 path (pair with merchant-demo mode 3): the merchant charges $U (BSC
# Testnet) and accepts the EIP-3009 `authorization` credential. The payer only
# SIGNS (no gas, no broadcast), so for that route this wallet needs $U — but NOT
# tBNB. `PAYER_PRIVATE_KEY` above is still the signer.
