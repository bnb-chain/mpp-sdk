{
  "name": "@bnb-chain/mpp-example-client-demo",
  "private": true,
  "version": "0.0.1",
  "description": "Node CLI payer for MPP 402 endpoints — fetch the challenge, build a credential with @bnb-chain/mpp/client, retry with Authorization, decode the Payment-Receipt.",
  "type": "module",
  "scripts": {
    "prestart": "pnpm -C ../.. build",
    "start": "node --env-file-if-exists=.env --import tsx --no-warnings src/pay.ts",
    "check:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@bnb-chain/mpp": "workspace:*",
    "mppx": "^0.6.28",
    "viem": "^2.51.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260323.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
