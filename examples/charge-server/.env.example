# Required — receive payment to this address (your merchant EVM address).
# LEAVE INTENTIONALLY BLANK in this template — the example refuses to
# start until you put a real address here. Defaulting to a real-looking
# placeholder (e.g. 0x000…000) risked users accidentally accepting
# payments to the burn address.
RECIPIENT_ADDRESS=

# Required — HMAC secret for mppx challenge binding (mppx-managed mode).
# Treat like a JWT signing key: rotate on suspected leak, never commit.
# Generate with: openssl rand -hex 32
MPP_SECRET_KEY=

# Required — server-side settlement signer private key (0x + 64 hex chars).
# Used to broadcast the on-chain settlement transaction for permit2
# credentials (`permitWitnessTransferFrom`). hash + transaction credentials
# do NOT use this key (the payer broadcasts their own tx); it's required to
# start because the BSC Testnet USDT deployment advertises permit2.
#
# Generate with: `openssl rand -hex 32`. The `0x` prefix is optional —
# the example accepts both 64-char bare hex (openssl default output) and
# 66-char 0x-prefixed forms.
# The account MUST hold tBNB (BSC Testnet) for gas — fund via:
#   - https://testnet.bnbchain.org/faucet-smart
#
# NEVER reuse a mainnet key. Treat this like a hot wallet key: rotate
# regularly, scope to a single deployment.
SETTLEMENT_PRIVATE_KEY=

# Optional — BSC Testnet RPC URL override. Defaults to the public
# data-seed endpoint (no API key). Swap to a NodeReal / QuickNode URL with
# your own API key if the public endpoint rate-limits under load.
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Optional — HTTP port. Defaults to 3000.
# PORT=3000
