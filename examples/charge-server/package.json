{
  "name": "@bnb-chain/mpp-example-charge-server",
  "private": true,
  "version": "0.0.0",
  "description": "Minimal Hono-based HTTP server demoing @bnb-chain/mpp/server with a 402 → settlement → Payment-Receipt flow.",
  "type": "module",
  "scripts": {
    "prestart": "pnpm -C ../.. build",
    "start": "node --env-file-if-exists=.env --import tsx --no-warnings src/index.ts",
    "check:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@bnb-chain/mpp": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "mppx": "^0.6.28",
    "viem": "^2.51.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260323.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
