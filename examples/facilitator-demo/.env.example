# Required — the MERCHANT's payout address. Settlement lands on-chain
# directly at this address; the facilitator never custodies funds.
# LEFT INTENTIONALLY BLANK — the gateway refuses to start without it.
MERCHANT_RECIPIENT_ADDRESS=

# Required — the FACILITATOR's HMAC secret for challenge binding.
# One secret per facilitator deployment (not per merchant).
# Generate with: openssl rand -hex 32
MPP_SECRET_KEY=

# Optional — the FACILITATOR's settlement signer (32-byte hex; 0x prefix
# optional). Leave empty for payer-funded only (`transaction` / `hash`).
# Set it to also sponsor `permit2` settlement — the facilitator's classic
# value-add: the signer broadcasts `permitWitnessTransferFrom` and pays
# gas, so fund it with tBNB: https://testnet.bnbchain.org/faucet-smart
# NEVER reuse a mainnet key.
SETTLEMENT_PRIVATE_KEY=

# Optional — where the merchant's existing API runs.
# UPSTREAM_URL=http://localhost:3002

# Optional — BSC Testnet RPC override (public default rate-limits).
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Optional — ports. Defaults: gateway 3003, upstream 3002.
# PORT=3003
# UPSTREAM_PORT=3002
