# Required — receive payment to this address (your merchant EVM address).
# LEFT INTENTIONALLY BLANK — the server refuses to start until you put a
# real address here (a placeholder risks accepting payments to a burn
# address). Funds settle on-chain DIRECTLY to this address.
RECIPIENT_ADDRESS=

# Required — HMAC secret for mppx challenge binding (mppx-managed mode).
# Treat like a JWT signing key. Generate with: openssl rand -hex 32
MPP_SECRET_KEY=

# Optional — server-side settlement signer private key (32-byte hex; the
# 0x prefix is optional). Leave EMPTY to run fully payer-funded: the
# server then advertises only `transaction` / `hash` credentials, holds
# no key, and spends no gas. Set it to also accept `permit2` (the server
# broadcasts `permitWitnessTransferFrom`; this account pays the gas) —
# fund it with tBNB: https://testnet.bnbchain.org/faucet-smart
# NEVER reuse a mainnet key. Treat as a hot wallet: rotate, scope per-deploy.
SETTLEMENT_PRIVATE_KEY=

# Optional — BSC Testnet RPC override (public default rate-limits).
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Optional — HTTP port. Defaults to 3001.
# PORT=3001
