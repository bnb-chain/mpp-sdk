# Optional. Zero-config defaults pair this app with examples/server on :3001.

# Vite proxy target for the merchant server.
# VITE_B402_SERVER_URL=http://127.0.0.1:3001

# The two protected MPP-native B402 routes.
# VITE_B402_EIP3009_ENDPOINT=/api/b402/eip3009
# VITE_B402_PERMIT2_ENDPOINT=/api/b402/permit2

# Optional wallet read RPCs; public defaults are suitable only for demo volume.
# VITE_BSC_TESTNET_RPC_URL=
# VITE_BSC_RPC_URL=
